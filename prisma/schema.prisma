generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DreamGoal {
  id        Int      @id @default(autoincrement())
  goalText  String
  years     Int      @default(5) // Количество лет для мечты (1-10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dream_goal")
}

// Цели на конкретный год (2025, 2026, 2027...)
model YearGoal {
  id        Int      @id @default(autoincrement())
  year      Int      // 2025, 2026, 2027...
  goalsJson String   // JSON array of goals for the year
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year])
  @@map("year_goals")
}

model PeriodGoal {
  id          Int      @id @default(autoincrement())
  periodType  String   // 'year', 'half_year', 'quarter', 'month', 'week'
  periodStart DateTime
  periodEnd   DateTime
  goalsJson   String   // JSON array of goals (legacy, для обратной совместимости)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("period_goals")
}

// Новая модель для отдельных целей с метаданными
model Goal {
  id          Int       @id @default(autoincrement())
  text        String    // Текст цели
  periodType  String    // 'year', 'half_year', 'quarter', 'month', 'week'
  periodKey   String    // Ключ периода: "2025", "2025-Q1", "2025-12", "2025-12-W1"
  
  // Статус и прогресс
  completed   Boolean   @default(false)
  completedAt DateTime?
  
  // Дедлайн
  deadline    DateTime?
  
  // Приоритет: 'high', 'medium', 'low'
  priority    String    @default("medium")
  
  // Теги (JSON array: ["работа", "здоровье"])
  tagsJson    String    @default("[]")
  
  // Связи с другими целями (JSON array of goal IDs that block this one)
  blockedByJson String  @default("[]")
  
  // История (JSON array of events: [{type: 'created'|'moved'|'completed', date, from?, to?}])
  historyJson String    @default("[]")
  
  // Порядок сортировки
  sortOrder   Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([periodType, periodKey])
  @@map("goals")
}

// Теги для целей
model GoalTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("#6B7280") // Цвет тега (hex)
  createdAt DateTime @default(now())

  @@map("goal_tags")
}

model DailyEntry {
  id         Int          @id @default(autoincrement())
  date       DateTime     @unique
  planText   String?
  factText   String?

  // НОВЫЕ ПОЛЯ: Контекст дня
  emotionalState    String?  // Эмоциональное состояние
  physicalState     String?  // Физическое состояние
  lifeEvents        String?  // Важные события дня (JSON)
  externalFactors   String?  // Внешние обстоятельства
  energyLevel       Int?     // Уровень энергии 1-10
  sleepQuality      Int?     // Качество сна 1-10
  familyTime        Int?     // Время с семьей (минуты)
  exerciseTime      Int?     // Время на спорт (минуты)

  // Выбранные задачи (для чекбоксов)
  selectedTasksJson String?  // JSON массив индексов выбранных задач

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  evaluation Evaluation?

  @@map("daily_entries")
}

model Evaluation {
  id                   Int        @id @default(autoincrement())
  dailyEntryId         Int        @unique
  dailyEntry           DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  // ГЛАВНАЯ МЕТРИКА
  dreamProgressScore   Int        @default(5) // Насколько день приблизил к мечте (1-10)

  // Классические метрики
  strategyScore        Int
  operationsScore      Int
  teamScore            Int
  efficiencyScore      Int
  overallScore         Float

  feedbackText         String
  planVsFactText       String

  // Вертикальный alignment
  alignmentDayWeek     String
  alignmentWeekMonth   String
  alignmentMonthQuarter String
  alignmentQuarterHalf String
  alignmentHalfYear    String
  alignmentYearDream   String

  // НОВЫЕ ПОЛЯ: Флаги баланса
  healthFlag           String?    // "ok", "warning", "critical"
  familyFlag           String?    // "ok", "warning", "critical"
  energyFlag           String?    // "ok", "warning", "critical"

  // НОВЫЕ ПОЛЯ: Горизонтальный alignment
  workHealthAlignment  String?    // works/partial/conflict/critical
  workFamilyAlignment  String?    // works/partial/conflict/critical
  workValuesAlignment  String?    // works/partial/conflict/critical

  recommendationsText  String
  suggestedTasksJson   String?    // JSON: предложенные задачи от ИИ
  createdAt            DateTime   @default(now())

  @@map("evaluations")
}

model OpenTask {
  id         Int       @id @default(autoincrement())
  taskText   String
  taskType   String    // 'strategic' or 'operational'
  originDate DateTime
  isClosed   Boolean   @default(false)
  closedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@map("open_tasks")
}

model UserProfile {
  id             Int      @id @default(autoincrement())
  name           String?  // Имя
  occupation     String?  // Работа/должность
  industry       String?  // Вид деятельности
  maritalStatus  String?  // Семейное положение
  hobbies        String?  // Хобби
  sports         String?  // Спорт
  location       String?  // Где живу
  age            Int?     // Возраст
  customInterests String? // JSON строка с динамическими интересами	
  education      String?  // Образование
  teamSize       Int?     // Размер команды
  workExperience String?  // Опыт работы
  values         String?  // Ценности
  challenges     String?  // Текущие вызовы
  other          String?  // Другая информация
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("user_profile")
}

model ProfileBlock {
  id         Int               @id @default(autoincrement())
  title      String            // Название блока (например: "Личные интересы", "Навыки")
  order      Int               @default(0) // Порядок отображения
  categories ProfileCategory[] // Категории внутри блока (опционально)
  items      ProfileItem[]     // Пункты напрямую в блоке (без категории)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("profile_blocks")
}

model ProfileCategory {
  id        Int           @id @default(autoincrement())
  blockId   Int           // Связь с блоком
  block     ProfileBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  title     String        // Название категории (например: "Личное", "Профессиональное")
  order     Int           @default(0) // Порядок внутри блока
  items     ProfileItem[] // Пункты внутри категории
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("profile_categories")
}

model ProfileItem {
  id         Int              @id @default(autoincrement())
  blockId    Int?             // Связь напрямую с блоком (если без категории)
  block      ProfileBlock?    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  categoryId Int?             // Связь с категорией (если внутри категории)
  category   ProfileCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fieldName  String           // Название поля (например: "Хобби", "Навык")
  fieldValue String           // Значение поля (например: "Фотография", "Python")
  content    String?          // Deprecated: для обратной совместимости
  order      Int              @default(0) // Порядок внутри блока/категории
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("profile_items")
}

// НОВАЯ ТАБЛИЦА: Периодические оценки (недельные, месячные)
model PeriodEvaluation {
  id                  Int      @id @default(autoincrement())
  periodType          String   // 'week', 'month', 'quarter', 'year', 'custom'
  periodStart         DateTime
  periodEnd           DateTime

  // Основные метрики
  dreamProgressScore  Float
  overallScore        Float

  // Блоки оценки (JSON с детальными данными)
  professionalBlock   String   // JSON с оценками профессионального блока
  personalBlock       String   // JSON с оценками личного блока
  socialBlock         String   // JSON с оценками социального блока
  balanceBlock        String   // JSON с оценками баланса

  // Анализ
  patterns            String   // JSON: паттерны поведения
  trends              String   // JSON: тренды
  goalsCompletion     String   // JSON: выполнение целей периода
  alignment           String   // JSON: детальный alignment анализ
  blockers            String?  // JSON: что блокирует движение к целям

  // Обратная связь
  feedbackText        String
  recommendationsText String
  insights            String?  // Глубокие инсайты (для долгосрочных периодов)

  createdAt           DateTime @default(now())

  @@map("period_evaluations")
}

// НОВАЯ ТАБЛИЦА: Контекст окружающего мира
model WorldContext {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique
  marketEvents    String?  // Рыночные события (JSON)
  personalEvents  String?  // Личные события: болезнь, отпуск и т.д.
  constraints     String?  // Ограничения и форс-мажоры
  notes           String?  // Произвольные заметки
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("world_context")
}

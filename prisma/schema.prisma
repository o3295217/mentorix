// МНОГОПОЛЬЗОВАТЕЛЬСКАЯ ВЕРСИЯ СХЕМЫ
// PostgreSQL для production

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== АУТЕНТИФИКАЦИЯ ====================

enum ThemePreference {
  light
  dark
  system
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String    // bcrypt hash
  role          String    @default("user") // "user" | "admin"
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  onboardingCompleted Boolean @default(false)
  themePreference ThemePreference @default(system)
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  
  // Связи
  dreamGoals    DreamGoal[]
  yearGoals     YearGoal[]
  periodGoals   PeriodGoal[]
  goals         Goal[]
  goalTags      GoalTag[]
  dailyEntries  DailyEntry[]
  openTasks     OpenTask[]
  profile       UserProfile?
  profileBlocks ProfileBlock[]
  habits        Habit[]
  insights      UserInsights?
  insightEntries InsightEntry[]
  stats         UserStats?
  periodEvaluations PeriodEvaluation[]
  worldContexts WorldContext[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  chatMessages  ChatMessage[]
  completedWork CompletedWork[]
  workSummaries WorkSummary[]
  planningProfile PlanningProfile?

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ==================== ЦЕЛИ ====================

model DreamGoal {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalText  String
  months    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("dream_goal")
}

model YearGoal {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  goalsJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
  @@index([userId])
  @@map("year_goals")
}

model PeriodGoal {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodType  String
  periodStart DateTime
  periodEnd   DateTime
  goalsJson   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, periodType, periodStart])
  @@index([userId])
  @@map("period_goals")
}

model Goal {
  id            Int       @id @default(autoincrement())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text          String
  periodType    String
  periodKey     String
  completed     Boolean   @default(false)
  completedAt   DateTime?
  deadline      DateTime?
  priority      String    @default("medium")
  tagsJson      Json      @default("[]")
  blockedByJson Json      @default("[]")
  historyJson   Json      @default("[]")
  sortOrder     Int       @default(0)
  scope         String?   @default("dream")
  rootYearGoalId String?
  parentId      Int?
  parent        Goal?     @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Goal[]    @relation("GoalHierarchy")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, periodType, periodKey])
  @@index([userId, completed])
  @@index([parentId])
  @@index([userId, scope])
  @@index([userId, rootYearGoalId])
  @@map("goals")
}

model GoalTag {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6B7280")
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
  @@map("goal_tags")
}

// ==================== ЕЖЕДНЕВНЫЕ ЗАПИСИ ====================

model DailyEntry {
  id               Int          @id @default(autoincrement())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  planText         String?
  factText         String?
  planSnapshotJson Json?
  extraTasksJson   Json         @default("[]")
  
  // Контекст дня
  emotionalState   String?
  physicalState    String?
  lifeEvents       String?
  externalFactors  String?
  energyLevel      Int?
  sleepQuality     Int?
  familyTime       Int?
  exerciseTime     Int?
  selectedTasksJson Json?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  evaluation       Evaluation?
  schedule         DailySchedule?

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
  @@map("daily_entries")
}

model DailySchedule {
  id            Int        @id @default(autoincrement())
  dailyEntryId  Int        @unique
  dailyEntry    DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  scheduleJson  Json
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("daily_schedules")
}

model Evaluation {
  id                    Int        @id @default(autoincrement())
  dailyEntryId          Int        @unique
  dailyEntry            DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  
  dreamProgressScore    Int        @default(5)
  strategicFocusScore   Int        @default(5)
  productivityScore     Int        @default(5)
  lifeBalanceScore      Int        @default(5)
  disciplineScore       Int        @default(5)
  overallScore          Float
  feedbackText          String
  planVsFactText        String
  
  // Вертикальный alignment
  alignmentDayWeek      String
  alignmentWeekMonth    String
  alignmentMonthQuarter String
  alignmentQuarterHalf  String
  alignmentHalfYear     String
  alignmentYearDream    String
  
  // Флаги баланса
  healthFlag            String?
  familyFlag            String?
  energyFlag            String?
  
  // Горизонтальный alignment
  workHealthAlignment   String?
  workFamilyAlignment   String?
  workValuesAlignment   String?
  
  recommendationsText   String
  suggestedTasksJson    Json?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now()) @updatedAt

  @@index([dreamProgressScore])
  @@index([createdAt])
  @@map("evaluations")
}

// ==================== ЗАДАЧИ ====================

model OpenTask {
  id         Int       @id @default(autoincrement())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskText   String
  taskType   String
  originDate DateTime
  isClosed   Boolean   @default(false)
  archiveStatus String?
  closedAt   DateTime?
  carriedFromMonth String? // месяц-источник «YYYY-MM», если задача пришла из незакрытых целей прошлого месяца
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, isClosed])
  @@index([userId, taskType, isClosed])
  @@map("open_tasks")
}

// ==================== ПРОФИЛЬ ====================

model UserProfile {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String?
  occupation      String?
  industry        String?
  maritalStatus   String?
  hobbies         String?
  sports          String?
  location        String?
  age             Int?
  customInterests String?
  education       String?
  teamSize        Int?
  workExperience  String?
  values          String?
  challenges      String?
  other           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_profile")
}

model ProfileBlock {
  id         Int               @id @default(autoincrement())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  order      Int               @default(0)
  categories ProfileCategory[]
  items      ProfileItem[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@map("profile_blocks")
}

model ProfileCategory {
  id        Int           @id @default(autoincrement())
  blockId   Int
  block     ProfileBlock  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  title     String
  order     Int           @default(0)
  items     ProfileItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("profile_categories")
}

model ProfileItem {
  id         Int              @id @default(autoincrement())
  blockId    Int?
  block      ProfileBlock?    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  categoryId Int?
  category   ProfileCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fieldName  String
  fieldValue String
  content    String?
  order      Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("profile_items")
}

// ==================== ПРИВЫЧКИ ====================

model Habit {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskText    String
  frequency   String   @default("daily")
  daysOfWeek  String?
  interval    Int?
  isActive    Boolean  @default(true)
  streak      Int      @default(0)
  bestStreak  Int      @default(0)
  totalDone   Int      @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@map("habits")
}

// ==================== ОЦЕНКИ ПЕРИОДОВ ====================

model PeriodEvaluation {
  id                  Int      @id @default(autoincrement())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodType          String
  periodStart         DateTime
  periodEnd           DateTime
  dreamProgressScore  Float
  overallScore        Float
  professionalBlock   String
  personalBlock       String
  socialBlock         String
  balanceBlock        String
  patterns            String
  trends              String
  goalsCompletion     String
  alignment           String
  blockers            String?
  feedbackText        String
  recommendationsText String
  insights            String?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([userId, periodType, periodStart])
  @@map("period_evaluations")
}

// ==================== КОНТЕКСТ ====================

model WorldContext {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  marketEvents    String?
  personalEvents  String?
  constraints     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("world_context")
}

// ==================== АНАЛИТИКА ====================

model UserInsights {
  id              Int      @id @default(autoincrement())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patterns        String?
  strengths       String?
  challenges      String?
  preferences     String?
  recommendations String?
  motivators      String?
  weeklySummary   String?
  evaluationCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_insights")
}

// Накопительный кэш знаний — каждая оценка добавляет наблюдения
model InsightEntry {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // дата дня к которому относится наблюдение (YYYY-MM-DD)
  category  String   // pattern | strength | challenge | preference | motivator | observation
  text      String   // конкретное наблюдение
  score     Float?   // оценка дня, к которому относится
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, category])
  @@index([userId, createdAt])
  @@map("insight_entries")
}

model UserStats {
  id                   Int      @id @default(autoincrement())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalDays            Int      @default(0)
  totalPlanned         Int      @default(0)
  totalCompleted       Int      @default(0)
  avgCompletionPct     Float    @default(0)
  avgDailyScore        Float    @default(0)
  completionByDayJson  Json     @default("{}")
  completionByTypeJson Json     @default("{}")
  frequentCompletedJson Json    @default("[]")
  frequentFailedJson   Json     @default("[]")
  habitsAvgCompletion  Float    @default(0)
  trendDirection       String?
  trendPct             Float    @default(0)
  bestDayOfWeek        String?
  worstDayOfWeek       String?
  optimalTaskCount     Int      @default(5)
  currentStreak        Int      @default(0)
  bestStreak           Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_stats")
}

// ==================== СБРОС ПАРОЛЯ ====================

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ==================== ВЕРИФИКАЦИЯ EMAIL ====================

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

// ==================== ВЫПОЛНЕННАЯ РАБОТА ====================

model CompletedWork {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String   // task | goal | habit | extra
  text        String
  category    String?  // стратегические | операционные | привычки | созвоны
  goalLink    String?  // periodKey цели (например 2026-03-W3)
  sourceType  String?  // dailyEntry | goal | habit
  sourceId    Int?
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, goalLink])
  @@map("completed_work")
}

model WorkSummary {
  id                Int      @id @default(autoincrement())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodType        String   // week | month | quarter
  periodKey         String   // 2026-03-W3, 2026-03, 2026-Q1
  summaryText       String   // компактная сводка для контекста ИИ
  keyAchievements   Json     @default("[]") // JSON array строк
  tasksCompleted    Int      @default(0)
  goalsCompleted    Int      @default(0)
  topCategoriesJson Json?    // JSON {"стратегические": 5, "операционные": 12}
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, periodType, periodKey])
  @@index([userId, periodType])
  @@map("work_summaries")
}

// ==================== ЧАТ ====================

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  role      String
  content   String
  metadataJson Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
  @@map("chat_messages")
}

// ==================== ПРОФИЛЬ ПЛАНИРОВАНИЯ ====================

model PlanningProfile {
  id               Int      @id @default(autoincrement())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hoursPerWeek     Int?      // сколько часов в неделю готов выделять
  experienceLevel  String?   // none | beginner | intermediate | expert
  hasBudget        String?   // none | limited | available
  currentWorkload  String?   // fulltime | parttime | freelance | free
  constraints      String?   // свободный текст: ограничения
  declined         Boolean  @default(false) // пользователь отказался заполнять профиль
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("planning_profiles")
}

// ==================== ДАТА-МИГРАЦИИ ====================
// Маркеры применённых одноразовых миграций данных (scripts/migrate-*).
// Таблица создаётся и заполняется самими скриптами; модель здесь нужна,
// чтобы prisma db push не пытался её удалить.

model DataMigration {
  name      String   @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz

  @@map("data_migrations")
}

// ==================== АУДИТ-ЛОГ ====================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  action    String   // login | logout | register | read | create | update | delete | password_change | lockout
  resource  String?  // daily_entry | goal | evaluation | profile | etc.
  resourceId String? // id записи
  details   String?  // доп. информация
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AIUsage {
  id           Int      @id @default(autoincrement())
  userId       String
  endpoint     String   // goals/chat | evaluate | daily/chat | daily/check-plan
  model        String   // claude-sonnet-4-20250514 etc.
  inputTokens  Int
  outputTokens Int
  costCents    Int      @default(0) // расход в центах, посчитан по тарифу модели на момент запроса
  durationMs   Int?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([endpoint])
  @@index([createdAt])
  @@map("ai_usage")
}

# AI Assistant - Production Environment Variables
# Скопируйте этот файл в .env.production и заполните значения

# ===========================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ===========================================

# Секретный ключ для шифрования (минимум 32 символа)
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=your-secret-key-here-minimum-32-characters

# API ключ Anthropic для Claude AI
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ===========================================
# АУТЕНТИФИКАЦИЯ
# ===========================================

# Включить многопользовательский режим
# - true: включена аутентификация, каждый пользователь видит только свои данные
# - false: однопользовательский режим для локальной разработки (по умолчанию)
AUTH_ENABLED=true

# Режим регистрации:
# - open: открытая регистрация (по умолчанию)
# - invite: только по коду приглашения
# - closed: регистрация закрыта
REGISTRATION_MODE=open

# Код приглашения (для режима invite)
INVITE_CODE=

# Максимальное количество пользователей (0 = без лимита)
MAX_USERS=0

# ===========================================
# СЕРВЕР
# ===========================================

# Порт приложения
APP_PORT=3000

# URL базы данных
DATABASE_URL=file:/app/data/production.db

# ===========================================
# ОПЦИОНАЛЬНО
# ===========================================

# Домен для HTTPS (если используете Caddy)
# DOMAIN=assistant.example.com

# Email для Let's Encrypt
# ACME_EMAIL=your@email.com

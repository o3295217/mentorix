# AI Assistant - Production Environment Variables
# Скопируйте этот файл в .env.production и заполните значения

# ===========================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ===========================================

# Секретный ключ для шифрования (минимум 32 символа)
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=your-secret-key-here-minimum-32-characters

# КРИТИЧНО: ключ шифрования пользовательских данных в БД (AES-256-GCM)
# Сгенерировать: openssl rand -hex 32
# Никогда не менять после создания данных: старые записи станут нечитаемыми.
ENCRYPTION_KEY=

# API ключ Anthropic для Claude AI.
# Production Contabo ходит напрямую к официальному endpoint api.anthropic.com;
# Cloudflare/Wrangler/Worker proxy не используется.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Модель Claude. Можно менять без пересборки Docker.
# Общий override для обоих уровней ниже (обратная совместимость): если заданы
# только этот параметр — обе категории задач (SMART и FAST) используют его.
# Если пусто, приложение использует встроенный fallback текущего сценария.
AI_MODEL=claude-sonnet-4-20250514

# Модель для СЛОЖНЫХ AI-задач (декомпозиция целей, оценка периода, прогноз).
# Приоритет: AI_MODEL_SMART → AI_MODEL → встроенный fallback (claude-sonnet-4-6).
# AI_MODEL_SMART=

# Модель для ПРОСТЫХ/частых AI-задач (оценка дня, чат о плане, проверка плана,
# обновление профиля понимания пользователя).
# Приоритет: AI_MODEL_FAST → AI_MODEL → встроенный fallback (claude-haiku-4-5).
# AI_MODEL_FAST=

# ===========================================
# АУТЕНТИФИКАЦИЯ
# ===========================================

# Включить многопользовательский режим
# - true: включена аутентификация, каждый пользователь видит только свои данные
# - false: однопользовательский режим для локальной разработки (по умолчанию)
AUTH_ENABLED=true

# Secure cookies для HTTPS. В production нельзя ставить false.
COOKIE_SECURE=true

# Режим регистрации:
# - open: открытая регистрация (по умолчанию)
# - invite: только по коду приглашения
# - closed: регистрация закрыта
REGISTRATION_MODE=open

# Код приглашения (для режима invite)
INVITE_CODE=

# Максимальное количество пользователей (0 = без лимита)
MAX_USERS=0

# ===========================================
# СЕРВЕР
# ===========================================

# Порт приложения
APP_PORT=3000

# Публичный HTTPS URL приложения для metadata и ссылок в email.
# Не секрет: передаётся и как Docker build arg, и как runtime env.
NEXT_PUBLIC_APP_URL=https://mentorix.aionlab.ru

# ===========================================
# БАЗА ДАННЫХ (PostgreSQL)
# ===========================================

# Креды PostgreSQL (используются docker-compose для создания БД и приложением для подключения)
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=ai_assistant

# DATABASE_URL собирается автоматически в docker-compose.production.yml
# Если запускаете без Docker, укажите вручную:
# DATABASE_URL=postgresql://ai_assistant:password@localhost:5432/ai_assistant

# ===========================================
# ОПЦИОНАЛЬНО
# ===========================================

# Telegram notifications from app container
TG_BOT_TOKEN=
TG_CHAT_ID=

# Домен для HTTPS (если используете Caddy)
# DOMAIN=assistant.example.com

# Email для Let's Encrypt
# ACME_EMAIL=your@email.com

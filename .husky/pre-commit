#!/bin/bash

# ===========================================
# Pre-commit hook: автообновление документации + напоминания
# ===========================================

# Цвета для вывода
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo ""

# ===========================================
# 1. Автоматически обновляем PROJECT_STATUS.md
# ===========================================
echo -e "${GREEN}📝 Обновляю PROJECT_STATUS.md...${NC}"
node scripts/update-docs.js

# Получаем список изменённых файлов
STAGED_FILES=$(git diff --cached --name-only)

echo ""

# Проверяем API routes
if echo "$STAGED_FILES" | grep -q "^app/api/"; then
    echo -e "${YELLOW}⚠️  Изменены API routes → проверь docs/ARCHITECTURE.md (секция API)${NC}"
fi

# Проверяем схему БД
if echo "$STAGED_FILES" | grep -q "prisma/schema.prisma"; then
    echo -e "${YELLOW}⚠️  Изменена схема БД → проверь docs/ARCHITECTURE.md (секция БД)${NC}"
fi

# Проверяем компоненты
if echo "$STAGED_FILES" | grep -q "^components/"; then
    echo -e "${YELLOW}⚠️  Изменены компоненты → проверь docs/ARCHITECTURE.md (секция Компоненты)${NC}"
fi

# Проверяем промпты AI
if echo "$STAGED_FILES" | grep -q "^lib/prompts/"; then
    echo -e "${YELLOW}⚠️  Изменены промпты AI → проверь docs/ARCHITECTURE.md (секция AI)${NC}"
fi

# Проверяем переменные окружения
if echo "$STAGED_FILES" | grep -q "^\.env"; then
    if ! echo "$STAGED_FILES" | grep -q "\.env\.example"; then
        echo -e "${YELLOW}⚠️  Изменены .env файлы → обнови .env.example${NC}"
    fi
fi

# Проверяем package.json
if echo "$STAGED_FILES" | grep -q "^package.json"; then
    echo -e "${YELLOW}⚠️  Изменён package.json → проверь README.md (секция Технологии)${NC}"
fi

# Проверяем CHANGELOG
if ! echo "$STAGED_FILES" | grep -q "CHANGELOG.md"; then
    echo -e "${RED}❌ CHANGELOG.md не обновлён!${NC}"
    echo -e "${YELLOW}   Добавь описание изменений в CHANGELOG.md${NC}"
    echo ""
    echo -e "Продолжить без обновления CHANGELOG? [y/N]"
    read -r response < /dev/tty
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        echo -e "${RED}Коммит отменён. Обнови CHANGELOG.md и попробуй снова.${NC}"
        exit 1
    fi
fi

echo ""
echo -e "${GREEN}✅ Pre-commit проверки пройдены${NC}"
echo ""

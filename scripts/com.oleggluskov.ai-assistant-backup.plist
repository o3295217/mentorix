<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oleggluskov.ai-assistant-backup</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/oleggluskov/Documents/GooglDisk/ai-assistant-spec/scripts/backup-db.sh</string>
    </array>
    
    <!-- Запуск каждый день в 23:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <!-- Также запускать при загрузке системы если пропущен -->
    <key>RunAtLoad</key>
    <false/>
    
    <key>StandardOutPath</key>
    <string>/Users/oleggluskov/Documents/GooglDisk/ai-assistant-spec/backups/launchd.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Users/oleggluskov/Documents/GooglDisk/ai-assistant-spec/backups/launchd-error.log</string>
</dict>
</plist>

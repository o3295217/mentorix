# Шаблон systemd-сервиса для tg-bot.sh.
# Пути ниже — под VK Cloud (User=ubuntu). На другом сервере замените
# /home/ubuntu и User на актуальные перед установкой в /etc/systemd/system/.

[Unit]
Description=AI Assistant Telegram Bot
After=docker.service
Requires=docker.service

[Service]
EnvironmentFile=-/home/ubuntu/.tg-bot-env
ExecStart=/usr/bin/bash /home/ubuntu/ai-assistant-spec/scripts/tg-bot.sh
Restart=always
RestartSec=10
MemoryMax=256M
CPUQuota=25%
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-assistant-spec
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Шаблон systemd-сервиса для tg-bot.sh.
# Пути ниже — под production на Contabo (User=oleg).
# Перед установкой в /etc/systemd/system/ проверьте путь проекта и User.

[Unit]
Description=AI Assistant Telegram Bot
After=docker.service
Requires=docker.service

[Service]
EnvironmentFile=-/home/oleg/.tg-bot-env
ExecStart=/usr/bin/bash /home/oleg/ai-assistant-spec/scripts/tg-bot.sh
Restart=always
RestartSec=10
MemoryMax=256M
CPUQuota=25%
User=oleg
WorkingDirectory=/home/oleg/ai-assistant-spec
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# ===========================================
# AI Effectiveness Assistant - Environment
# ===========================================
# Скопируйте в .env.local и заполните значения

# --- БАЗА ДАННЫХ (PostgreSQL) ---
DATABASE_URL="postgresql://ai_assistant:ai_assistant_dev@localhost:5432/ai_assistant"

# --- АУТЕНТИФИКАЦИЯ ---
# Включить многопользовательский режим
AUTH_ENABLED=true

# Секретный ключ для подписи сессий (минимум 32 символа)
AUTH_SECRET="change-this-to-a-long-random-string-min-32-chars"

# Режим регистрации: open | invite | closed
REGISTRATION_MODE=open

# Код приглашения (для режима invite)
INVITE_CODE=

# Максимум пользователей (0 = без лимита)
MAX_USERS=0

# Secure cookies (true только для HTTPS)
COOKIE_SECURE=false

# --- AI API ---
# Anthropic Claude API ключ
ANTHROPIC_API_KEY="sk-ant-api03-your-key-here"

# --- ПРИЛОЖЕНИЕ ---
# URL приложения (для ссылок в email)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Порт приложения
APP_PORT=3000

# --- EMAIL (опционально, для сброса пароля) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@example.com

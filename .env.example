# ===========================================
# AI Effectiveness Assistant - Environment
# ===========================================
# Скопируйте в .env.local и заполните значения

# --- БАЗА ДАННЫХ (PostgreSQL) ---
DATABASE_URL="postgresql://ai_assistant:ai_assistant_dev@localhost:5432/ai_assistant"

# --- АУТЕНТИФИКАЦИЯ ---
# Включить многопользовательский режим
AUTH_ENABLED=true

# Секретный ключ для подписи сессий (минимум 32 символа)
AUTH_SECRET="change-this-to-a-long-random-string-min-32-chars"

# Режим регистрации: open | invite | closed
REGISTRATION_MODE=open

# Код приглашения (для режима invite)
INVITE_CODE=

# Максимум пользователей (0 = без лимита)
MAX_USERS=0

# Secure cookies (true только для HTTPS)
COOKIE_SECURE=false

# --- ШИФРОВАНИЕ ДАННЫХ ---
# Ключ шифрования пользовательских данных (AES-256-GCM)
# Генерация: openssl rand -hex 32
# ⚠️ Без этого ключа зашифрованные данные невозможно прочитать!
# ENCRYPTION_KEY=

# --- AI API ---
# Anthropic Claude API ключ. Клиент использует официальный SDK endpoint напрямую.
ANTHROPIC_API_KEY="sk-ant-api03-your-key-here"

# Модель Claude по умолчанию (общий override для обоих уровней ниже).
# Если пусто, код использует встроенный fallback каждого уровня.
# AI_MODEL="claude-sonnet-4-20250514"

# Модель для СЛОЖНЫХ AI-задач (декомпозиция целей, оценка периода, прогноз).
# Приоритет: AI_MODEL_SMART → AI_MODEL → встроенный fallback (claude-sonnet-4-6).
# AI_MODEL_SMART="claude-sonnet-4-20250514"

# Модель для ПРОСТЫХ/частых AI-задач (оценка дня, чат о плане, проверка плана,
# обновление профиля понимания пользователя).
# Приоритет: AI_MODEL_FAST → AI_MODEL → встроенный fallback (claude-haiku-4-5).
# Если задан только AI_MODEL (без AI_MODEL_SMART/AI_MODEL_FAST) — обе категории
# задач используют его, поведение не меняется.
# AI_MODEL_FAST="claude-haiku-4-5-20251015"

# --- ПРИЛОЖЕНИЕ ---
# URL приложения (для ссылок в email)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Порт приложения
APP_PORT=3000

# --- EMAIL (опционально, для сброса пароля) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@example.com
